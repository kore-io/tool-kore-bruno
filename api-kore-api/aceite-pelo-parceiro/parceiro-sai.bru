meta {
  name: O parceiro sai do casamento
  type: http
  seq: 7
  tags: [
    local
  ]
}

delete {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/memberships/{{partnerMembershipId}}
  body: none
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

assert {
  res.status: eq 204
}

docs {
  `DELETE /v1/weddings/{weddingId}/memberships/{id}` do próprio vínculo (RN07): com outro dono, o parceiro pode sair. O Partner dele perde o login (177(10)), e a saída vai ao log na mesma transação (`membership.left`, 179(1)).
}
