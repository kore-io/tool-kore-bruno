meta {
  name: Esconder a assinatura
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/site
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "showPlannerCredit": false
  }
}

assert {
  res.status: eq 200
}

docs {
  `PATCH /v1/weddings/{weddingId}/site` com `showPlannerCredit` (RN05): a dona esconde a assinatura do rodapé, com log. Aceito mesmo sem colaboradora.
}
