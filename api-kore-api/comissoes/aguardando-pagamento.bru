meta {
  name: Meus casamentos aguardando pagamento
  type: http
  seq: 4
  tags: [
    local
  ]
}

get {
  url: {{baseUrl}}/v1/me/weddings?status=awaiting_payment
  body: none
  auth: none
}

params:query {
  status: awaiting_payment
}

assert {
  res.status: eq 200
  res.body.weddings: isArray
  res.body.summary.awaitingPayment: isNumber
}

docs {
  `GET /v1/me/weddings?status=awaiting_payment` (Comissões RN08): o filtro recorta só a lista; o Resumo conta todos.
}
