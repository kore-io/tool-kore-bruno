meta {
  name: Convidar o parceiro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/access-invitations
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "kind": "partner",
    "emails": ["{{partnerEmail}}"]
  }
}

script:pre-request {
  bru.setVar("partnerEmail", `parceiro-${Date.now().toString(36)}@kore.local`);
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("invitationId", res.body.invitations[0].id);
    bru.setVar("invitationExpiresAt", res.body.invitations[0].expiresAt);
  }
}

assert {
  res.status: eq 201
  res.body.invitations.length: eq 1
  res.body.invitations[0].kind: eq partner
  res.body.invitations[0].email: eq {{partnerEmail}}
  res.body.invitations[0].resent: eq false
}

tests {
  test("o convite vale 30 dias (RN03)", () => {
    const days = (new Date(res.body.invitations[0].expiresAt) - Date.now()) / 86400000;
    expect(days).to.be.within(29.9, 30.1);
  });
}

docs {
  `POST /v1/weddings/{weddingId}/access-invitations`, tipo `partner`, com um e-mail (RN01, RN02): quem envia é um dono, enquanto o casamento tem menos de 2 donos. O convite vale 30 dias (RN03).

  Erros: `400` (e-mail inválido; mais de um e-mail fora do tipo `couple`), `403 ACTION_NOT_ALLOWED`, `404 WEDDING_NOT_FOUND`, `409 OWNERS_FULL`, `409 PLANNER_ALREADY` e `409 COUPLE_INVITATIONS_FULL` (só no tipo `couple`).
}
