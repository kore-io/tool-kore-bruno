meta {
  name: Convite em casamento de outra pessoa
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/weddings/00000000-0000-4000-8000-000000000000/access-invitations
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "kind": "partner",
    "emails": ["{{partnerEmail}}"]
  }
}

assert {
  res.status: eq 404
  res.body.error: eq WEDDING_NOT_FOUND
}

docs {
  Isolamento (RN01 de "Papéis e permissões"): sem vínculo com o casamento, a resposta é `404 WEDDING_NOT_FOUND`, a mesma de um casamento que não existe.
}
