meta {
  name: Criar um grupo de uma pessoa
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/parties
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "name": "Padrinhos",
    "guests": [
      {
        "name": "Leonardo Castro",
        "phone": "+351 912 345 678"
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("padrinhosId", res.body.id);
    bru.setVar("leonardoId", res.body.guests[0].id);
  }
}

assert {
  res.status: eq 201
  res.body.guests[0].phone: eq "+351912345678"
}

docs {
  Quem vai sozinho é um grupo de uma pessoa (RN01). O telefone internacional começa com "+" e o código do país (RN04).
}
