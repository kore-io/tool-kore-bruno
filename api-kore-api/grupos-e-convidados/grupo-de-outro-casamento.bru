meta {
  name: Grupo que não é deste casamento
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/parties/00000000-0000-4000-8000-000000000000
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.error: eq PARTY_NOT_FOUND
}

docs {
  O grupo não existe neste casamento ou está na lixeira: `404 PARTY_NOT_FOUND`.
}
