meta {
  name: Importar a lista
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/guest-imports/paste
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "groups": [
      {
        "name": "Carla Nunes",
        "guests": [
          "Carla Nunes",
          "Lucas Nunes",
          "Ana Nunes"
        ]
      }
    ],
    "removedInPreview": 1
  }
}

assert {
  res.status: eq 201
  res.body.parties: eq 1
  res.body.guests: eq 3
}

docs {
  `POST /v1/weddings/{weddingId}/guest-imports/paste` (RN12, RN14): os grupos como ficaram na prévia, validados de novo e criados numa transação. `removedInPreview` vai para o evento `importacao`.

  Erros: `400`, `422 DUPLICATE` (com `path`), `422 TOO_MANY_GUESTS`.
}
