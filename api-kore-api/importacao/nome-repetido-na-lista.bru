meta {
  name: Nome repetido na lista
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/guest-imports/paste
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "groups": [
      {
        "name": "Primos",
        "guests": [
          "Felipe Rocha",
          "felipe  rocha"
        ]
      }
    ],
    "removedInPreview": 0
  }
}

assert {
  res.status: eq 422
  res.body.error: eq DUPLICATE
  res.body.path: eq groups.0.guests.1
}

docs {
  RN11: um nome repetido no mesmo grupo (sem diferenciar maiúsculas, acentos e espaços) recusa o pedido inteiro.
}
