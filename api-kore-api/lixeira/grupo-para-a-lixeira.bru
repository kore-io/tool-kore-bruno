meta {
  name: Grupo para a lixeira
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/parties/{{padrinhosId}}
  body: none
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

assert {
  res.status: eq 200
  res.body.name: eq Padrinhos
  res.body.guests: eq 2
}

docs {
  `DELETE /v1/weddings/{weddingId}/parties/{partyId}` (RN03): o grupo vai com os convidados e as vagas dele, com o mesmo `trashBatchId`.

  Erros: `403 ALREADY_RESPONDED`, `404 PARTY_NOT_FOUND`.
}
