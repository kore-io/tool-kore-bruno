meta {
  name: Tag para a lixeira
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/tags/{{tagId}}
  body: none
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

assert {
  res.status: eq 200
  res.body.name: eq Padrinhos da Ana
}

docs {
  `DELETE /v1/weddings/{weddingId}/tags/{tagId}` (RN05): a tag sai das listas e do limite de 10; os vínculos ficam guardados para a restauração.
}
