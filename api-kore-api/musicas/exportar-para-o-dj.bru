meta {
  name: Exportar para o DJ
  type: http
  seq: 2
  tags: [
    local
  ]
}

get {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/song-suggestions/export
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
  res.headers["cache-control"]: eq no-store
}

tests {
  test("o nome do arquivo no padrão da exportação (RN06)", () => {
    expect(res.headers["content-disposition"]).to.contain("musicas-");
  });
}

docs {
  `GET /v1/weddings/{id}/song-suggestions/export` (RN06): o `.xlsx`, tudo como texto; sem sugestões, `409 NOTHING_TO_EXPORT`.
}
