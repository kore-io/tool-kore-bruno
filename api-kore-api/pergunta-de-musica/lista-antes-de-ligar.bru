meta {
  name: Músicas sem sugestões
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/song-suggestions
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.total: eq 0
}

docs {
  `GET /v1/weddings/{id}/song-suggestions` (RN05): da mais antiga para a mais nova, 50 por vez; com a pergunta desligada, `404 SONG_QUESTION_DISABLED`.
}
