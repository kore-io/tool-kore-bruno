meta {
  name: Prévia usada de novo
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/sites/{{siteSlug}}/preview-session
  body: json
  auth: none
}

headers {
  Origin: {{siteOrigin}}
}

body:json {
  {
    "token": "{{previewToken}}"
  }
}

assert {
  res.status: eq 404
  res.body.error: eq PREVIEW_INVALID
}

docs {
  RN04: cada prévia vale uma vez só, por poucos minutos ("Esta prévia não vale mais.").
}
