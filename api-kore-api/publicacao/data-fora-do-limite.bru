meta {
  name: Data fora do limite
  type: http
  seq: 2
  tags: [
    local
  ]
}

post {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/publication
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "endDate": "2028-05-16"
  }
}

assert {
  res.status: eq 422
  res.body.error: eq END_DATE_OUT_OF_RANGE
  res.body.endDateMax: eq 2028-05-15
}

docs {
  RN04: fora dos limites, `422 END_DATE_OUT_OF_RANGE` com os limites ("Escolham uma data depois do casamento e até {limite}."), e o casamento continua em rascunho.
}
