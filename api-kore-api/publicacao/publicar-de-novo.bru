meta {
  name: Publicar de novo
  type: http
  seq: 4
  tags: [
    local
  ]
}

post {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/publication
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "endDate": "2027-08-15"
  }
}

assert {
  res.status: eq 409
  res.body.error: eq NOT_DRAFT
}

docs {
  RN03 e RN05: só se publica de rascunho; o app mostra "O site já está publicado.".
}
