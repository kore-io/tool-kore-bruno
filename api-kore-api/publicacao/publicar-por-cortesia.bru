meta {
  name: Publicar por Cortesia
  type: http
  seq: 3
  tags: [
    local
  ]
}

post {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/publication
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "endDate": "2027-08-15"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq published
  res.body.endDate: eq 2027-08-15
  res.body.publicationSource: eq courtesy
}

docs {
  `POST /v1/weddings/{id}/publication` (RN02 a RN05): só a dona, de um rascunho com endereço, data e UF. Grava o status, a data de saída do ar, a origem `courtesy` e quem publicou; o `paidThrough` fica nulo (decisão 217(4)). O site passa a responder como publicado, e o link do grupo identifica o grupo.
}
