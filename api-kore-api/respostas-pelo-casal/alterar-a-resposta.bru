meta {
  name: Alterar a resposta
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/guests/{{rafaelId}}/response
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

script:pre-request {
  // A versão lida no Painel (2 depois do RSVP no Local; 1 sem ele).
  req.setBody({ ...req.getBody(), version: Number(bru.getVar("duarteVersion")) });
}

body:json {
  {
    "version": 1,
    "status": "confirmed"
  }
}

assert {
  res.status: eq 200
  res.body.partyId: eq {{duarteId}}
}

docs {
  `PUT /v1/weddings/{id}/guests/{guestId}/response` (RN04): grava como o RSVP, com o casal como autor, sem notificação; `409 RSVP_CHANGED` se o grupo mudou com o Dialog aberto.
}
