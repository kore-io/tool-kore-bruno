meta {
  name: Editar a tag
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/tags/{{tagId}}
  body: json
  auth: none
}

headers {
  Origin: {{appOrigin}}
}

body:json {
  {
    "name": "Padrinhos da Ana",
    "color": null
  }
}

assert {
  res.status: eq 200
  res.body.name: eq Padrinhos da Ana
  res.body.color: isNull
}

docs {
  `PATCH /v1/weddings/{weddingId}/tags/{tagId}` (RN06): renomeia e troca ou tira a cor. O nome não aceita `null`.

  Erros: `400`, `404 TAG_NOT_FOUND`, `409 TAG_NAME_TAKEN`.
}
