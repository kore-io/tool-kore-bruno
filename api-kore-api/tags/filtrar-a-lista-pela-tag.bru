meta {
  name: Filtrar a lista pela tag
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/parties?tag={{tagId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.total: eq 2
}

docs {
  RN09 de Tags e RN13 de Grupos: o filtro mostra o grupo quando ele ou algum convidado dele tem a tag.
}
