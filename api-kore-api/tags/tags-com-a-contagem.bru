meta {
  name: Tags com a contagem
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/weddings/{{weddingId}}/tags
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.limit: eq 10
  res.body.data.length: eq 1
  res.body.data[0].guests: eq 5
}

docs {
  `GET /v1/weddings/{weddingId}/tags` (RN04, RN05): a contagem junta a tag do grupo e a do convidado, cada pessoa uma vez, sem vagas vazias. Aqui: Luiz, Célia e Ana Clara (Família Moreira) e Leonardo e Pedro (Padrinhos).
}
